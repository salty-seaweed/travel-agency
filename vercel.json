{
  "version": 2,
  "name": "threadtravels-frontend",
  "buildCommand": "cd frontend && node build-low-memory.js",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm ci --legacy-peer-deps --no-optional --prefer-offline --production=false",
  "framework": "vite",
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=3072 --no-warnings --max-semi-space-size=32 --optimize-for-size --gc-interval=100",
    "CI": "false",
    "GENERATE_SOURCEMAP": "false",
    "DISABLE_ESLINT_PLUGIN": "true",
    "TSC_COMPILE_ON_ERROR": "true",
    "VITE_BUILD_CHUNK_SIZE_LIMIT": "800"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://web-production-a324.up.railway.app/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
