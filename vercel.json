{
  "version": 2,
  "name": "threadtravels-frontend",
  "buildCommand": "cd frontend && node build-low-memory.js",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm ci --legacy-peer-deps --prefer-offline --no-audit --no-fund --ignore-scripts --frozen-lockfile",
  "cleanUrls": true,
  "trailingSlash": false,
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=6144 --no-warnings --max-semi-space-size=64",
    "CI": "true",
    "GENERATE_SOURCEMAP": "false",
    "DISABLE_ESLINT_PLUGIN": "true",
    "TSC_COMPILE_ON_ERROR": "true",
    "VITE_BUILD_CHUNK_SIZE_LIMIT": "800",
    "VERCEL_FORCE_NO_BUILD_CACHE": "1",
    "NPM_CONFIG_CACHE": "/tmp/.npm",
    "SKIP_INSTALL_DEPS": "true"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://web-production-a324.up.railway.app/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
