{
  "version": 2,
  "name": "threadtravels-frontend",
  "buildCommand": "cd frontend && timeout 600 node build-low-memory.js",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && timeout 300 npm ci --legacy-peer-deps --prefer-offline --no-audit --no-fund --ignore-scripts --frozen-lockfile --production=false",
  "framework": "vite",
  "functions": {
    "frontend/dist/**": {
      "maxDuration": 10
    }
  },
  "builds": [
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "regions": ["iad1"],
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=6144 --no-warnings --max-semi-space-size=64",
    "CI": "true",
    "GENERATE_SOURCEMAP": "false",
    "DISABLE_ESLINT_PLUGIN": "true",
    "TSC_COMPILE_ON_ERROR": "true",
    "VITE_BUILD_CHUNK_SIZE_LIMIT": "800",
    "VERCEL_FORCE_NO_BUILD_CACHE": "1",
    "NPM_CONFIG_PRODUCTION": "false",
    "NPM_CONFIG_OPTIONAL": "false",
    "NPM_CONFIG_CACHE": "/tmp/.npm"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://web-production-a324.up.railway.app/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
