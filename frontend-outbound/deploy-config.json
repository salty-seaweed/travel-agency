{
  "name": "frontend-outbound",
  "domain": "local.threadtravels.com",
  "buildCommand": "npm run build",
  "outputDir": "dist",
  "environment": {
    "NODE_ENV": "production",
    "VITE_API_BASE_URL": "https://web-production-a324.up.railway.app/api",
    "VITE_APP_TYPE": "outbound",
    "VITE_BRAND_NAME": "Thread Global Travels",
    "VITE_BRAND_TAGLINE": "Your World Awaits"
  },
  "nginx": {
    "server_name": "local.threadtravels.com",
    "root": "/path/to/built/files",
    "index": "index.html"
  }
}
