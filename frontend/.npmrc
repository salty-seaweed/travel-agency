# Optimize npm for Vercel builds
fund=false
audit=false
save-exact=true
prefer-offline=true
cache=/tmp/.npm
progress=false
loglevel=warn
optional=false
save-dev=false
legacy-peer-deps=true
engine-strict=false
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
# Keep package-lock for reproducible builds
package-lock=true