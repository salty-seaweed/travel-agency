# Vercel ignore file for frontend deployment
node_modules
.env.local
.env.development
.env.test
*.log
.DS_Store
coverage/
.nyc_output/
build/
dist/

# Keep package-lock.json for faster, consistent installs
pnpm-lock.yaml
yarn.lock
.pnpm-lock.yaml
.yarnclean

# Large dependency files that can cause issues
**/node_modules/**/test/
**/node_modules/**/tests/
**/node_modules/**/*.test.js
**/node_modules/**/*.spec.js
**/node_modules/**/coverage/
**/node_modules/**/.nyc_output/
**/node_modules/**/docs/
**/node_modules/**/doc/
**/node_modules/**/README*
**/node_modules/**/CHANGELOG*
**/node_modules/**/*.md

# Cache and temporary files
.cache/
.vite/
.parcel-cache/
.next/
.nuxt/
.output/
.turbo/

# Development and build artifacts
*.tsbuildinfo
tsconfig.tsbuildinfo

# Backend files (we only want frontend deployed)
../api/
../travel_agency/
../data_exports/
../*.py
../requirements*.txt
../Dockerfile
../docker-compose*.yml
../nginx.conf
